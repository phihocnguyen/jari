        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"jari-backend\", uri=~\"/api/v1/.*\"}[$__range]))",
          "refId": "A"
        }
      ],
