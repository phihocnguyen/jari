# Backend URL (backend chạy trên host)
BASE_URL=http://localhost:8080

# Auth — required (auto-register nếu user chưa có)
AUTH_EMAIL=user@example.com
AUTH_PASSWORD=Password123@

# Tuỳ chọn — bỏ qua auto-discover/create nếu đã biết ID
# WORKSPACE_ID=
# PROJECT_ID=
# ISSUE_ID=

# --- benchmark.js (dev baseline) ---
# smoke | read_dashboard | mixed_workload | all
K6_SCENARIO=all
K6_READ_VUS=10
K6_MIXED_VUS=5
K6_WRITE_RATIO=10

# --- load.js (stress cố định: 100 VU + 500 req/s) ---
K6_LOAD_MODE=both
K6_CONCURRENT_USERS=100
K6_TARGET_RPS=500
K6_MAX_VUS=250
K6_LOAD_DURATION=3m

# --- write-load.js (create/update-heavy) ---
# Mix: ~20% create, ~50% update, ~30% read
# Local baseline ~100 VU; updates hit a small seed pool (no sprint → board stays small)
# Mix: ~10% create (backlog) / ~70% update status+fields / ~20% read
# K6_CONCURRENT_USERS=100
# K6_THINK_MS=300
# K6_LOAD_DURATION=5m
# K6_SEED_ISSUES=5
# K6_MAX_VUS=150
# write-load luôn tạo workspace/project tạm rồi teardown xóa (CASCADE issues)
# K6_SKIP_CLEANUP=true   # giữ data để debug
# (trên Spring) HIKARI_MAX_POOL_SIZE=100

# --- capacity.js (tìm max concurrent users & max req/s) ---
# vus | rps | both
K6_CAPACITY_MODE=both
K6_STEP_DURATION=90s
K6_STEP_SECONDS=90
# Tăng dần từng bậc, mỗi bậc giữ 90s
K6_VU_STEPS=5,10,20,30,50,75,100,150,200
K6_RPS_STEPS=10,25,50,100,150,200,300,500,750,1000
K6_MAX_VUS=500
# Step "ổn định" nếu: error ≤ 5% và p95 ≤ 3000ms
K6_MAX_ERROR_RATE=0.05
K6_MAX_P95_MS=3000
