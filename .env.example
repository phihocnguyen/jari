# PostgreSQL (docker compose up -d postgres)
POSTGRES_DB=jari
POSTGRES_USER=jari
POSTGRES_PASSWORD=jari
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/jari
DB_USER=jari
DB_PASS=jari

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

