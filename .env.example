# PostgreSQL (docker compose up -d postgres)
POSTGRES_DB=jari
POSTGRES_USER=jari
POSTGRES_PASSWORD=jari
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/jari
DB_USER=jari
DB_PASS=jari

# JSON logs cho ELK (Filebeat)
# SPRING_PROFILES_ACTIVE=docker

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Gridex / GUI client (app + Postgres đều chạy local):
# postgresql://jari:jari@localhost:5432/jari  — SSL: Off
#
# Logstash indexer (monitoring/.env):
# JARI_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/jari
# JARI_DB_USER=jari
# JARI_DB_PASS=jari
